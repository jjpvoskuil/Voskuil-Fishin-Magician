# Copy this file's contents into Streamlit Cloud's "Secrets" settings
# (or into .streamlit/secrets.toml for local runs - that file is gitignored).
#
# GITHUB_TOKEN: a fine-grained GitHub Personal Access Token scoped to just
# this repo, with "Contents: Read and write" permission. Used only to
# commit logged trips (data/trip_log.csv) back to the repo so they persist
# across app restarts/redeploys.
GITHUB_TOKEN = "github_pat_..."
GITHUB_REPO = "jjpvoskuil/Voskuil-Fishin-Magician"

# ANTHROPIC_API_KEY: enables the Lure Inventory page's "Scan a lure" feature
# - take/upload a photo of a lure's package, Claude reads the brand/product
# name off the label, looks it up on Cabela's for the real product details
# (SKU, price, category, photo), and shows you matches to confirm before
# anything is added. Get a key at https://console.anthropic.com/ - this is
# billed to your own Anthropic account per scan, separate from any Claude
# subscription. Without this secret, that section just stays hidden and the
# manual "Add a lure" form still works as before.
ANTHROPIC_API_KEY = "sk-ant-..."
# Optional - override the vision model used for scans (defaults to
# core.lure_vision.DEFAULT_MODEL) without a code change, e.g. if that
# default model name is ever retired.
# ANTHROPIC_MODEL = "claude-sonnet-4-5"
